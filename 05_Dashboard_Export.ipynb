   "source": [
    "## Step 6 — Build JavaScript"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# JavaScript — renders all charts and handles the class filter\n",
    "html_script = \"\"\"\n",
    "<script>\n",
    "const NET_DATA    = \"\"\" + net_json_str + \"\"\";\n",
    "const TABLE_DATA  = \"\"\" + table_json_str + \"\"\";\n",
    "const TIME_DATA   = \"\"\" + time_json_str + \"\"\";\n",
    "const BURST_DATA  = \"\"\" + burst_json_str + \"\"\";\n",
    "const GAUGES_DATA = \"\"\" + gauges_json_str + \"\"\";\n",
    "const ALL_NODES   = \"\"\" + all_nodes_json_str + \"\"\";\n",
    "\n",
    "const DARK = {\n",
    "  paper_bgcolor:\"#0D0D1A\", plot_bgcolor:\"#0D0D1A\",\n",
    "  font:{color:\"#e8e8f0\"}, legend:{bgcolor:\"#1a1a2e\",bordercolor:\"#333\"}\n",
    "};\n",
    "const CFG = {responsive:true, displayModeBar:true, displaylogo:false};\n",
    "\n",
    "Plotly.newPlot(\"gaugeChart\",  GAUGES_DATA.data, Object.assign({}, GAUGES_DATA.layout, DARK), CFG);\n",
    "Plotly.newPlot(\"networkGraph\",NET_DATA.data,    Object.assign({}, NET_DATA.layout, DARK), CFG);\n",
    "Plotly.newPlot(\"rankTable\",   TABLE_DATA.data,  Object.assign({}, TABLE_DATA.layout, DARK), CFG);\n",
    "Plotly.newPlot(\"timeChart\",   TIME_DATA.data,   Object.assign({}, TIME_DATA.layout, DARK, {barmode:\"stack\"}), CFG);\n",
    "Plotly.newPlot(\"burstChart\",  BURST_DATA.data,  Object.assign({}, BURST_DATA.layout, DARK), CFG);\n",
    "\n",
    "document.getElementById(\"networkGraph\").on(\"plotly_click\", function(data) {\n",
    "  const pt = data.points[0];\n",
    "  if (!pt.customdata) return;\n",
    "  const [txid, cls, risk, rank, ts] = pt.customdata;\n",
    "  const clsCol = {Illicit:\"#FF4444\", Licit:\"#00C9A7\", Unknown:\"#AAAAAA\"};\n",
    "  document.getElementById(\"d-txid\").textContent  = txid;\n",
    "  document.getElementById(\"d-class\").textContent = cls;\n",
    "  document.getElementById(\"d-class\").style.color = clsCol[cls]||\"#fff\";\n",
    "  document.getElementById(\"d-risk\").textContent  = risk;\n",
    "  document.getElementById(\"d-rank\").textContent  = \"#\" + rank;\n",
    "  document.getElementById(\"d-ts\").textContent    = ts;\n",
    "  document.getElementById(\"nodeDetail\").classList.add(\"visible\");\n",
    "});\n",
    "\n",
    "function applyFilter() {\n",
    "  const cls      = document.getElementById(\"classFilter\").value;\n",
    "  const filtered = cls === \"All\" ? ALL_NODES : ALL_NODES.filter(n=>n.class_label===cls);\n",
    "  document.getElementById(\"filter-info\").textContent =\n",
    "    cls === \"All\" ? \"\" : \"Showing \" + filtered.length.toLocaleString() + \" nodes\";\n",
    "\n",
    "  const visArr = document.getElementById(\"networkGraph\").data.map(t =>\n",
    "    (!t.name || cls===\"All\" || t.name===cls) ? true : \"legendonly\"\n",
    "  );\n",
    "  Plotly.restyle(\"networkGraph\",\"visible\",visArr);\n",
    "\n",
    "  const colourMap = {\n",
    "    Illicit:\"rgba(255,68,68,0.2)\",\n",
    "    Licit:\"rgba(0,201,167,0.2)\",\n",
    "    Unknown:\"rgba(170,170,170,0.13)\"\n",
    "  };\n",
    "  const top20   = filtered.slice().sort((a,b)=>b.risk_score-a.risk_score).slice(0,20);\n",
    "  const rowFill = top20.map(r=>colourMap[r.class_label]||\"rgba(170,170,170,0.13)\");\n",
    "\n",
    "  Plotly.react(\"rankTable\",[{\n",
    "    type:\"table\",\n",
    "    header:{values:[\"<b>#</b>\",\"<b>txId</b>\",\"<b>Class</b>\",\"<b>Risk Score</b>\",\"<b>Time Step</b>\"],\n",
    "            fill:{color:\"#1A1A2E\"},font:{color:\"white\",size:12},align:\"center\",height:32},\n",
    "    cells:{values:[top20.map((_,i)=>i+1),top20.map(r=>r.txId),top20.map(r=>r.class_label),\n",
    "                   top20.map(r=>r.risk_score.toFixed(4)),top20.map(r=>r.time_step)],\n",
    "           fill:{color:[rowFill,rowFill,rowFill,rowFill,rowFill]},\n",
    "           font:{color:\"white\",size:11},\n",
    "           align:[\"center\",\"left\",\"center\",\"center\",\"center\"],height:28}\n",
    "  }], Object.assign({},TABLE_DATA.layout,DARK), CFG);\n",
    "\n",
    "  const illTS={}, predTS={};\n",
    "  filtered.forEach(n=>{\n",
    "    if(n.time_step<0) return;\n",
    "    if(n.class_label===\"Illicit\") illTS[n.time_step]=(illTS[n.time_step]||0)+1;\n",
    "    if(n.class_label===\"Unknown\") predTS[n.time_step]=(predTS[n.time_step]||0)+1;\n",
    "  });\n",
    "  const steps=Object.keys(Object.assign({},illTS,predTS)).map(Number).sort((a,b)=>a-b);\n",
    "  Plotly.react(\"timeChart\",[\n",
    "    {type:\"bar\",name:\"Confirmed Illicit\",x:steps,y:steps.map(s=>illTS[s]||0),marker:{color:\"#FF4444\"},opacity:0.9},\n",
    "    {type:\"bar\",name:\"GNN-Predicted Illicit\",x:steps,y:steps.map(s=>predTS[s]||0),marker:{color:\"#FF9900\"},opacity:0.7}\n",
    "  ],Object.assign({},TIME_DATA.layout,DARK,{barmode:\"stack\"}),CFG);\n",
    "}\n",
    "</script>\n",
    "</body>\n",
    "</html>\"\"\"\n",
    "print('✅ JavaScript ready')"
   ]
  },
