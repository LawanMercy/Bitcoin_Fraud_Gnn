{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 02 · Feature Engineering\n",
    "## Graph-Aware Feature Construction for Fraud Detection\n",
    "\n",
    "Raw node features alone miss the most important signal in a transaction network: **who you transact with matters as much as what you do**. This notebook engineers three feature families:\n",
    "\n",
    "| Family | Description | Motivation |\n",
    "|--------|-------------|------------|\n",
    "| **Structural** | Centrality, degree, clustering | Position in the network reveals influence and risk |\n",
    "| **Temporal** | Burst activity, lifetime, recency | Illicit nodes tend to appear in short bursts |\n",
    "| **Neighbourhood** | Illicit neighbour ratio, risk contagion | Guilt-by-association is empirically validated in fraud |\n",
    "\n",
    "These features are concatenated with Elliptic's original 166-dimensional feature vector before training."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings, os\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.facecolor':'#0D1117','axes.facecolor':'#161B22',\n",
    "    'axes.edgecolor':'#30363D','axes.labelcolor':'#C9D1D9',\n",
    "    'xtick.color':'#8B949E','ytick.color':'#8B949E',\n",
    "    'text.color':'#C9D1D9','grid.color':'#21262D',\n",
    "    'grid.linestyle':'--','figure.dpi':130,\n",
    "})\n",
    "\n",
    "# ── Load data ─────────────────────────────────────────────────────────────────\n",
    "feat_cols = ['txId','time_step'] + [f'f{i}' for i in range(1,166)]\n",
    "features  = pd.read_csv('../data/elliptic_txs_features.csv', header=None, names=feat_cols)\n",
    "classes   = pd.read_csv('../data/elliptic_txs_classes.csv')\n",
    "edges     = pd.read_csv('../data/elliptic_txs_edgelist.csv')\n",
    "\n",
    "df = features.merge(classes, on='txId', how='left')\n",
    "df['class'] = df['class'].replace({'unknown':0,'1':1,'2':2}).astype(float)\n",
    "df['class_label'] = df['class'].map({1.0:'Illicit',2.0:'Licit',0.0:'Unknown'})\n",
    "\n",
    "print(f'Loaded {len(df):,} nodes and {len(edges):,} edges')\n",
    "print('Building graph…')\n",
    "G = nx.from_pandas_edgelist(edges, 'txId1', 'txId2', create_using=nx.DiGraph())\n",
    "print('Graph ready.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── A. Structural features ─────────────────────────────────────────────────────\n",
    "print('Computing structural features…')\n",
    "\n",
    "node_ids = df['txId'].tolist()\n",
    "\n",
    "in_deg  = dict(G.in_degree())\n",
    "out_deg = dict(G.out_degree())\n",
    "\n",
    "# Approximate betweenness (k=500 pivots — good balance speed/accuracy on large graphs)\n",
    "print('  Betweenness centrality (k=500)…')\n",
    "betweenness = nx.betweenness_centrality(G, normalized=True, k=500)\n",
    "\n",
    "# PageRank — captures recursive influence\n",
    "print('  PageRank…')\n",
    "pagerank = nx.pagerank(G, alpha=0.85, max_iter=300)\n",
    "\n",
    "# Hub / Authority scores (HITS algorithm)\n",
    "print('  HITS (hub/authority)…')\n",
    "hubs, authorities = nx.hits(G, max_iter=100, normalized=True)\n",
    "\n",
    "struct_df = pd.DataFrame({\n",
    "    'txId'        : node_ids,\n",
    "    'in_degree'   : [in_deg.get(n,0)       for n in node_ids],\n",
    "    'out_degree'  : [out_deg.get(n,0)      for n in node_ids],\n",
    "    'total_degree': [in_deg.get(n,0)+out_deg.get(n,0) for n in node_ids],\n",
    "    'degree_ratio': [out_deg.get(n,0)/(in_deg.get(n,0)+1e-6) for n in node_ids],\n",
    "    'betweenness' : [betweenness.get(n,0)  for n in node_ids],\n",
    "    'pagerank'    : [pagerank.get(n,0)     for n in node_ids],\n",
    "    'hub_score'   : [hubs.get(n,0)         for n in node_ids],\n",
    "    'auth_score'  : [authorities.get(n,0)  for n in node_ids],\n",
    "})\n",
    "\n",
    "print(f'✅ Structural features: {struct_df.shape[1]-1} columns')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── B. Temporal features ───────────────────────────────────────────────────────\n",
    "print('Computing temporal features…')\n",
    "\n",
    "ts_df = df[['txId','time_step']].copy()\n",
    "\n",
    "# Wallet lifetime: last_seen - first_seen per wallet\n",
    "# (In Elliptic, txId is unique per time step, so we use the time_step directly)\n",
    "ts_df['lifetime'] = 1  # single-observation nodes have lifetime 1\n",
    "\n",
    "# Time-step burst features: how many transactions occurred in the SAME time step?\n",
    "ts_counts = df.groupby('time_step').size().rename('ts_volume')\n",
    "ts_df     = ts_df.merge(ts_counts.reset_index(), on='time_step')\n",
    "\n",
    "# Illicit density at same time step (computed from labelled nodes only)\n",
    "ts_ill   = df[df['class']==1].groupby('time_step').size().rename('ts_illicit_count')\n",
    "ts_licit = df[df['class']==2].groupby('time_step').size().rename('ts_licit_count')\n",
    "ts_stats  = pd.DataFrame({'time_step': range(1, 50)})\n",
    "ts_stats  = ts_stats.merge(ts_ill.reset_index(), on='time_step', how='left')\n",
    "ts_stats  = ts_stats.merge(ts_licit.reset_index(), on='time_step', how='left')\n",
    "ts_stats  = ts_stats.merge(ts_counts.reset_index(), on='time_step', how='left')\n",
    "ts_stats  = ts_stats.fillna(0)\n",
    "ts_stats['ts_illicit_rate'] = ts_stats['ts_illicit_count'] / (ts_stats['ts_volume'] + 1e-6)\n",
    "\n",
    "ts_df = ts_df.merge(ts_stats[['time_step','ts_illicit_rate']], on='time_step', how='left')\n",
    "\n",
    "# Recency: normalised time step position (0=earliest, 1=latest)\n",
    "ts_df['time_recency'] = (ts_df['time_step'] - 1) / 48.0\n",
    "\n",
    "temporal_df = ts_df[['txId','time_step','ts_volume','ts_illicit_rate','time_recency']]\n",
    "print(f'✅ Temporal features: {temporal_df.shape[1]-1} columns')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── C. Neighbourhood / contagion features ─────────────────────────────────────\n",
    "print('Computing neighbourhood features (guilt-by-association)…')\n",
    "\n",
    "# Build label lookup\n",
    "label_map = df.set_index('txId')['class'].to_dict()\n",
    "\n",
    "neigh_records = []\n",
    "for node in node_ids:\n",
    "    preds = list(G.predecessors(node))  # nodes that sent to this node\n",
    "    succs = list(G.successors(node))    # nodes this node sent to\n",
    "    all_nb = preds + succs\n",
    "\n",
    "    nb_labels = [label_map.get(n, 0) for n in all_nb]\n",
    "    n_ill   = sum(1 for l in nb_labels if l == 1)\n",
    "    n_lic   = sum(1 for l in nb_labels if l == 2)\n",
    "    n_unk   = sum(1 for l in nb_labels if l == 0)\n",
    "    total_nb = len(all_nb) + 1e-6\n",
    "\n",
    "    # Predecessor-specific illicit ratio (who sent money TO this node)\n",
    "    pred_labels = [label_map.get(n, 0) for n in preds]\n",
    "    pred_ill_ratio = sum(1 for l in pred_labels if l==1) / (len(preds)+1e-6)\n",
    "\n",
    "    neigh_records.append({\n",
    "        'txId'            : node,\n",
    "        'nb_illicit_ratio': n_ill / total_nb,\n",
    "        'nb_licit_ratio'  : n_lic / total_nb,\n",
    "        'nb_unknown_ratio': n_unk / total_nb,\n",
    "        'nb_total'        : len(all_nb),\n",
    "        'pred_illicit_ratio': pred_ill_ratio,\n",
    "    })\n",
    "\n",
    "neigh_df = pd.DataFrame(neigh_records)\n",
    "print(f'✅ Neighbourhood features: {neigh_df.shape[1]-1} columns')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── D. Merge all features ──────────────────────────────────────────────────────\n",
    "orig_feats = [f'f{i}' for i in range(1,166)]\n",
    "\n",
    "full_df = (df[['txId','time_step','class','class_label'] + orig_feats]\n",
    "           .merge(struct_df,   on='txId', how='left')\n",
    "           .merge(temporal_df.drop('time_step',axis=1), on='txId', how='left')\n",
    "           .merge(neigh_df,    on='txId', how='left'))\n",
    "\n",
    "# Fill any NaNs from merge\n",
    "full_df = full_df.fillna(0)\n",
    "\n",
    "print(f'Final feature matrix: {full_df.shape[0]:,} rows × {full_df.shape[1]} columns')\n",
    "print(f'  Original Elliptic features : 165')\n",
    "print(f'  Structural features added  : {len(struct_df.columns)-1}')\n",
    "print(f'  Temporal features added    : {len(temporal_df.columns)-2}')\n",
    "print(f'  Neighbourhood features     : {len(neigh_df.columns)-1}')\n",
    "\n",
    "# Save\n",
    "full_df.to_csv('../data/full_features.csv', index=False)\n",
    "print('\\n✅ Saved → ../data/full_features.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── E. Feature importance preview (Random Forest on labelled subset) ───────────\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "labelled = full_df[full_df['class'] != 0].copy()\n",
    "feature_cols = [c for c in full_df.columns\n",
    "                if c not in ['txId','time_step','class','class_label']]\n",
    "\n",
    "X = labelled[feature_cols].values\n",
    "y = (labelled['class'] == 1).astype(int).values  # 1=illicit, 0=licit\n",
    "\n",
    "rf = RandomForestClassifier(n_estimators=100, n_jobs=-1, random_state=42,\n",
    "                             class_weight='balanced')\n",
    "rf.fit(X, y)\n",
    "\n",
    "imp_df = pd.DataFrame({'feature': feature_cols,\n",
    "                        'importance': rf.feature_importances_})\\\n",
    "           .sort_values('importance', ascending=False).head(20)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "colours = ['#FF4444' if any(k in f for k in ['illicit','nb_','pred_'])\n",
    "           else '#00C9A7' if any(k in f for k in ['pagerank','betweenness','hub','auth'])\n",
    "           else '#4A90D9'\n",
    "           for f in imp_df['feature']]\n",
    "ax.barh(imp_df['feature'][::-1], imp_df['importance'][::-1], color=colours[::-1])\n",
    "ax.set_title('Top 20 Feature Importances (Random Forest)', fontsize=13)\n",
    "ax.set_xlabel('Importance')\n",
    "\n",
    "# Legend\n",
    "from matplotlib.patches import Patch\n",
    "ax.legend(handles=[\n",
    "    Patch(color='#FF4444', label='Neighbourhood / contagion'),\n",
    "    Patch(color='#00C9A7', label='Centrality / structural'),\n",
    "    Patch(color='#4A90D9', label='Original Elliptic feature'),\n",
    "], loc='lower right')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../data/fig_feature_importance.png', bbox_inches='tight', dpi=130)\n",
    "plt.show()\n",
    "print('\\nFeature engineering complete. Proceed to 03_GNN_Classifier.ipynb')"
   ]
  }
 ],
